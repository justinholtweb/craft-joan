{% extends "_layouts/cp" %}

{% set title = "Field layouts"|t('joan') %}
{% set selectedSubnavItem = 'layouts' %}

{% block actionButton %}
    <div class="flex">
        <a class="btn" href="{{ actionUrl('joan/export/download', { report: 'instances', format: 'csv' }) }}">{{ "Export CSV"|t('joan') }}</a>
        {% include "joan/_partials/refresh" %}
    </div>
{% endblock %}

{% block content %}
    {% include "joan/_partials/style" %}

    <p class="joan-note">
        {{ "Every field layout on the site, and what owns it. Layouts marked “other” belong to something that isn’t an element type — a Hyper link type, say — and Craft’s own “Used by” panel doesn’t list them, so a field used only there looks unused in the control panel."|t('joan') }}
    </p>

    <form method="get" class="joan-filters">
        <div class="field">
            <div class="heading"><label>{{ "Kind"|t('joan') }}</label></div>
            <div class="input">
                <div class="select">
                    <select name="kind" onchange="this.form.submit()">
                        <option value="">{{ "Any"|t('joan') }}</option>
                        {% for value, label in {
                            element: 'Element types'|t('joan'),
                            other: 'Other owners'|t('joan'),
                            unattributed: 'Nothing claims it'|t('joan'),
                        } %}
                            <option value="{{ value }}"{{ kind == value ? ' selected' }}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
        </div>
    </form>

    <p class="joan-sub">{{ "Showing {shown} of {total}."|t('joan', { shown: layouts|length, total: total }) }}</p>

    <table class="data fullwidth joan-table">
        <thead>
            <tr>
                <th>{{ "Layout"|t('joan') }}</th>
                <th>{{ "Type"|t('joan') }}</th>
                <th class="joan-num">{{ "Tabs"|t('joan') }}</th>
                <th class="joan-num">{{ "Fields"|t('joan') }}</th>
                <th class="joan-num">{{ "Elements"|t('joan') }}</th>
                <th>{{ "Fields on it"|t('joan') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for layout in layouts %}
                <tr>
                    <td>
                        {% if layout.cpEditUrl %}
                            <a href="{{ layout.cpEditUrl }}">{{ layout.label }}</a>
                        {% else %}
                            {{ layout.label }}
                        {% endif %}
                        {% if layout.kind == 'unattributed' %}
                            <div class="joan-sub error">{{ "nothing claims this layout"|t('joan') }}</div>
                        {% elseif layout.kind == 'other' %}
                            <div class="joan-sub">{{ "not an element type"|t('joan') }}</div>
                        {% endif %}
                    </td>
                    <td>{{ layout.typeName ?? '—' }}</td>
                    <td class="joan-num">{{ layout.tabCount }}</td>
                    <td class="joan-num">{{ layout.fieldCount }}</td>
                    <td class="joan-num">{{ layout.id and counts[layout.id] is defined ? counts[layout.id]|number_format : '—' }}</td>
                    <td class="joan-sub">
                        {% for row in fieldsByLayout[layout.uid] ?? [] %}
                            <a href="{{ url('joan/fields/' ~ row.field.uid) }}">{{ row.instance.handle }}</a>{{ not loop.last ? ', ' }}
                        {% else %}
                            {{ "no custom fields"|t('joan') }}
                        {% endfor %}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
