{# Inline rather than an asset bundle: it's a few dozen lines of CSS, and a bundle would mean
   clearing the CP resource cache every time one of them changed.
   Layout only. Colour, type and status all come from Craft's own tokens and classes —
   `status-label`, `warning has-icon`, `light`, `smalltext`, `code` — so Joan follows the
   control panel's theme instead of carrying a palette of its own. #}
{% css %}
    .joan-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 14px;
        margin-bottom: 24px;
    }
    .joan-card {
        background: var(--gray-050);
        border: 1px solid var(--border-hairline-medium);
        border-radius: var(--large-border-radius);
        padding: 14px 16px;
    }
    .joan-card h4 {
        margin: 0 0 4px;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--fg-subtle);
    }
    .joan-figure {
        font-size: 26px;
        line-height: 1.15;
        font-weight: 500;
    }
    .joan-card.is-flag { background: var(--yellow-050); border-color: var(--yellow-300); }
    .joan-card.is-bad { background: var(--red-050); border-color: var(--red-300); }
    .joan-table td, .joan-table th { vertical-align: top; }
    .joan-table td.joan-num, .joan-table th.joan-num { text-align: right; font-variant-numeric: tabular-nums; }
    .joan-note {
        border-left: 3px solid var(--border-hairline-medium);
        padding: 2px 0 2px 12px;
        margin: 0 0 18px;
        color: var(--fg-subtle);
    }
    .joan-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: flex-end;
        margin-bottom: 18px;
    }
    .joan-filters > .field { margin: 0; }
    .joan-refs {
        margin: 0;
        padding: 0;
        list-style: none;
    }
    .joan-refs li {
        padding: 4px 0;
        border-bottom: 1px solid var(--border-hairline);
    }
    .joan-refs .joan-snippet {
        display: block;
        color: var(--fg-subtle);
        white-space: pre-wrap;
        word-break: break-word;
    }
    .joan-weak { opacity: 0.6; }
    .joan-bar {
        background: var(--gray-200);
        border-radius: var(--radius-lg);
        height: 6px;
        overflow: hidden;
        min-width: 90px;
    }
    .joan-bar span { display: block; height: 100%; background: var(--bg-enabled); }
    .joan-section-heading { margin-top: 28px; }
{% endcss %}
