# Keep the distributed package to what a site actually needs at runtime.
# docs/ stays: the README links into it.
/.gitattributes    export-ignore
/.gitignore        export-ignore
/phpunit.xml       export-ignore
/ecs.php           export-ignore
/phpstan.neon      export-ignore
/tests             export-ignore
# Plugin Store marketing images: ~8MB of PNG that no install runs on.
# (Abacus and Scrub currently ship theirs; this follows the rule above instead.)
/promos            export-ignore
